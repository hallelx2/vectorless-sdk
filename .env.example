# Copy this to .env and fill in your LLM API key.
# The server needs an LLM provider for document summarization and query retrieval.

# Required: at least one LLM provider key
ANTHROPIC_API_KEY=sk-ant-...

# SDK test configuration (these match docker-compose.yml defaults)
VECTORLESS_BASE_URL=http://localhost:8080
VECTORLESS_API_KEY=vl_test_sk_1234567890abcdef
